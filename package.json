{
  "name": "sentinela",
  "version": "2.1.0",
  "description": "Sentinela — Enterprise Security Auditor v2.1 (Sessões Persistentes + Daemon + Relatórios Completos)",

  "type": "module",
  "bin": {
    "sentinela": "sentinela.mjs"
  },
  "scripts": {
    "start":         "node sentinela.mjs start",
    "done":          "node sentinela.mjs done",
    "status":        "node sentinela.mjs status",
    "sessions":      "node sentinela.mjs sessions",
    "audit":         "node src/auditor.mjs",
    "audit:crawl":   "node src/auditor.mjs --crawl",
    "audit:active":  "node src/auditor.mjs --active"
  },
  "dependencies": {
    "playwright": "^1.48.0",
    "chalk": "^5.3.0"
  }
}
